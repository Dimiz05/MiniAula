# Docker Compose database credentials
MYSQL_DATABASE=miniaula
MYSQL_USER=miniaula
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# Published ports (bound to 127.0.0.1)
API_PORT=3000
WEB_PORT=8080

# API configuration
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Frontend build: base URL of the API as seen from the browser
VITE_API_URL=http://localhost:3000/api
