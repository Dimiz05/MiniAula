# Runtime
NODE_ENV=development
PORT=3000

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=miniaula
MYSQL_USER=miniaula
MYSQL_PASSWORD=replace-with-your-local-database-password
MYSQL_LOGGING=false

# Authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# HTTP security
CORS_ORIGIN=http://localhost:5173
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX=10
REGISTER_RATE_WINDOW_MINUTES=60
REGISTER_RATE_MAX=5
